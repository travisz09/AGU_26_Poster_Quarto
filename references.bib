 @inproceedings{HPC_2023, address={New York, NY, USA}, series={PEARC ’23}, title={The Sol Supercomputer at Arizona State University}, ISBN={978-1-4503-9985-2}, url={https://doi.org/10.1145/3569951.3597573}, DOI={10.1145/3569951.3597573}, abstractNote={The Sol supercomputer provides ASU researchers access to a state-of-the-art system with an observed GPU-only HPL speed of 2.272 PetaFLOP/s. This short paper provides a motivation for the supercomputer as well as a technical reference of its many components, in the hopes that the implicit template will encourage peer institutions to also generate corresponding publications and foster discussion. The supplemental git repository [2] contains finer details on the system’s configuration and has the ability to be updated as the system evolves.}, booktitle={Practice and Experience in Advanced Research Computing 2023: Computing for the Common Good}, publisher={Association for Computing Machinery}, author={Jennewein, Douglas M. and Lee, Johnathan and Kurtz, Chris and Dizon, William and Shaeffer, Ian and Chapman, Alan and Chiquete, Alejandro and Burks, Josh and Carlson, Amber and Mason, Natalie and Kobawala, Arhat and Jagadeesan, Thirugnanam and Basani, Praful Bhargav and Battelle, Torey and Belshe, Rebecca and McCaffrey, Deb and Brazil, Marisa and Inumella, Chaitanya and Kuznia, Kirby and Buzinski, Jade and Shah, Dhruvil Deepakbhai and Dudley, Sean M. and Speyer, Gil and Yalim, Jason}, year={2023}, pages={296–301}, collection={PEARC ’23} }

